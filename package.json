{
  "name": "design-system-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens:check": "pnpm --filter @ds/tokens check",
    "tokens:build": "pnpm --filter @ds/tokens build",
    "lint": "oxlint && stylelint \"**/*.css\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm tokens:check && pnpm tokens:build && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "1.94.0",
    "stylelint": "^18.0.0",
    "typescript": "~7.0.2"
  }
}
