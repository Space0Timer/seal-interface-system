{
  "name": "@ds/playground",
  "private": true,
  "type": "module",
  "description": "Reference screens and Storybook. Screens appear here only after the owner approves them.",
  "scripts": {
    "dev": "pnpm --filter @ds/tokens build && vite",
    "build": "vite build && storybook build --quiet --output-dir storybook-static",
    "storybook": "storybook dev --port 6006",
    "test": "playwright test",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@ds/react": "workspace:*",
    "@ds/tokens": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "^10.6.7",
    "vite": "^8.3.8"
  }
}
